# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram / Meta App
NEXT_PUBLIC_INSTAGRAM_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Session signing (REQUIRED for signed sessions). Generate: openssl rand -base64 48
SESSION_SECRET=
# Token encryption at rest (AES-256-GCM, 32 bytes). Generate: openssl rand -base64 32
# Leave empty to keep tokens plaintext; set it to encrypt all new/updated tokens.
TOKEN_ENCRYPTION_KEY=
# Rollout flags - see lib/auth.ts, PHASE0.md and docs/TODO-ANDROID-AUTH.md
# SECURE BY DEFAULT: when NODE_ENV=production and SESSION_SECRET is set, AUTH_ENFORCE is ON and
# SESSION_ACCEPT_LEGACY is OFF. Leave these two lines commented out to get that behaviour.
# Only set them to override (1 = on, 0 = off). Example: keep the old Android app working for now:
# AUTH_ENFORCE=0
# SESSION_ACCEPT_LEGACY=1

# Shared secret for cron, scheduler and /api/hooks/* routes (Authorization: Bearer <CRON_SECRET>).
# Generate: openssl rand -base64 32. Without it those routes refuse every call.
CRON_SECRET=
# Delayed DM steps (>5s) are queued only when this is 1 AND something calls /api/cron/process-scheduled. See docs/SCHEDULER.md
SCHEDULER_ENABLED=0
# Days to keep raw webhook payloads (PII) before the scheduler deletes them. Default 30.
WEBHOOK_RETENTION_DAYS=30

# Instagram Audit (public lookup)
# users.id of the connected account whose token is used for public lookups (Business Discovery).
AUDIT_LOOKUP_USER_ID=
# Cap on live (uncached) Instagram lookups per hour, protects the shared token. Default 60.
AUDIT_MAX_LOOKUPS_PER_HOUR=60
# Dev/test only: AUDIT_PROVIDER=fixture serves fake profiles. Ignored when NODE_ENV=production.
AUDIT_PROVIDER=

# AI Gateway / Auto Reply
GATEWAY_SECRET=

# Internal API Hooks
API_SECRET_KEY=
